# Replace with the lowercase image name shown in your GitHub Actions run.
DIARY_IMAGE=ghcr.io/fuyushibakyosu/diary:latest
DIARY_PORT=8787
# Use an absolute NAS path if you manage containers from a GUI.
DIARY_DATA_DIR=./data
TZ=Asia/Hong_Kong
# Only configure these when accessing through your HTTPS reverse proxy.
APP_ORIGIN=
COOKIE_SECURE=false
